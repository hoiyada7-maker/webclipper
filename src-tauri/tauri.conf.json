{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Toolbox",
  "version": "0.3.1",
  "identifier": "com.hoiyada7.mdtoolbox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MD Toolbox",
        "width": 900,
        "height": 660,
        "minWidth": 640,
        "minHeight": 440,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/"]
  }
}
